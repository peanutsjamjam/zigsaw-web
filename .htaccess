# 本番ビルド (dist/) を /~sugawara/zigsaw/ で透過的に配信する
RewriteEngine On

# .cgi を CGI スクリプトとして実行
AddHandler cgi-script .cgi

# 画像は宣言どおりの Content-Type で扱わせ、内容からの MIME 推測（sniffing）を無効化する。
# 万一おかしなファイルが images/ に混じっても HTML/JS として実行させないための多層防御。
<If "%{REQUEST_URI} =~ m#/images/#">
    Header always set X-Content-Type-Options "nosniff"
</If>

# すでに dist/ 配下へのリクエストはそのまま（無限ループ防止）
RewriteRule ^dist/ - [L]

# ルート ("/~sugawara/zigsaw/") は dist/index.html を返す
RewriteRule ^$ dist/index.html [L]

# 実在するファイル/ディレクトリ（api.cgi, images/ など）はそのまま配信/実行
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# それ以外のパスはすべて dist/ 配下へ転送
RewriteRule ^(.+)$ dist/$1 [L]
