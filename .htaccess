# 本番ビルド (dist/) を /~sugawara/zigsaw/ で透過的に配信する
RewriteEngine On

# .cgi を CGI スクリプトとして実行
AddHandler cgi-script .cgi

# リクエストボディの上限。画像アップロード（デコード後 8MB まで）が base64 で
# 約 4/3 に膨らむぶんの余裕をみた値。api.cgi の $MAX_BODY_BYTES と揃えること。
# ここで弾ければ CGI プロセスが起動する前に 413 を返せる。
LimitRequestBody 12582912

# 画像は宣言どおりの Content-Type で扱わせ、内容からの MIME 推測（sniffing）を無効化する。
# 万一おかしなファイルが appdata/ に混じっても HTML/JS として実行させないための多層防御。
<If "%{REQUEST_URI} =~ m#/appdata/#">
    Header always set X-Content-Type-Options "nosniff"
</If>

# すでに dist/ 配下へのリクエストはそのまま（無限ループ防止）
RewriteRule ^dist/ - [L]

# ルート ("/~sugawara/zigsaw/") は dist/index.html を返す
RewriteRule ^$ dist/index.html [L]

# 実在するファイル/ディレクトリ（api.cgi, appdata/ など）はそのまま配信/実行
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# それ以外のパスはすべて dist/ 配下へ転送
RewriteRule ^(.+)$ dist/$1 [L]
