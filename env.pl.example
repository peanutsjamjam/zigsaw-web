# env.pl のひな型。これをコピーして env.pl を作り、環境ごとに内容を変える。
#   cp env.pl.example env.pl   （env.pl は git 管理外）
# api.cgi が同じディレクトリの env.pl を require し、下記の変数を読む。

# 共通ライブラリ PJJ（github.com/peanutsjamjam/pjj-perl5）の置き場所。
# api.cgi はこれを @INC に足してから PJJ::* を読む。dev と本番は同じサーバー上にあり
# 両方のパスが存在するので、どちらを使うかはここで明示すること。
#   dev  : /home/sugawara/lib/perl5   （作業用チェックアウト）
#   本番 : /var/lib/perl5             （GitHub から clone したもの）
$main::PJJ_LIB = '/home/sugawara/lib/perl5';

# 実行環境名。'development' か 'production'。dev 専用エンドポイント（dev_users 等）の
# 出し分けに使う。
$main::ZIGSAW_ENV = 'development';   # 本番環境では 'production' にする

# アプリのベース URL（末尾スラッシュ付き）。メール内リンク（サインアップ/リセット）や
# 画像の絶対 URL の生成に使う。これを設定すると Host ヘッダに依存しなくなるため、
# リセットリンク等の Host インジェクションを防げる。環境ごとに実際の URL を入れること。
#   dev  例: https://peanutsjamjam.jp/~sugawara/zigsaw/
#   本番 例: https://zigsaw.peanutsjamjam.jp/
$main::ZIGSAW_BASE_URL = 'https://peanutsjamjam.jp/~sugawara/zigsaw/';

# 以下はテスト（t/）用の差し替え口。dev / 本番の env.pl では設定しない（既定値のまま）。
# 確認メール（サインアップ・パスワード再設定）の差出人。
# 設定しないと 'zigsaw@example.com' になるので、必ず自分のドメインのアドレスにすること。
$main::ZIGSAW_MAIL_FROM = 'zigsaw@example.com';

# 接続する PostgreSQL のデータベース名（既定は 'zigsaw'）。テスト（t/）が専用 DB に差し替える。
$main::ZIGSAW_DB = 'zigsaw';

# 以下はテスト用の差し替え口（dev / 本番では設定しない）。
#   $main::ZIGSAW_SENDMAIL       = '/usr/sbin/sendmail';      # sendmail のパス
#   $main::ZIGSAW_QUARANTINE_DIR = '/home/zigsaw/quarantine'; # 緊急退避先

1;
