# env.pl のひな型。これをコピーして env.pl を作り、環境ごとに内容を変える。
#   cp env.pl.example env.pl   （env.pl は git 管理外）
# api.cgi が同じディレクトリの env.pl を require し、下記の変数を読む。

# 実行環境名。'development' か 'production'。dev 専用エンドポイント（dev_users 等）の
# 出し分けに使う。
$main::ZIGSAW_ENV = 'development';   # 本番環境では 'production' にする

# アプリのベース URL（末尾スラッシュ付き）。メール内リンク（サインアップ/リセット）や
# 画像の絶対 URL の生成に使う。これを設定すると Host ヘッダに依存しなくなるため、
# リセットリンク等の Host インジェクションを防げる。環境ごとに実際の URL を入れること。
#   dev  例: https://peanutsjamjam.jp/~sugawara/zigsaw/
#   本番 例: https://zigsaw.peanutsjamjam.jp/
$main::ZIGSAW_BASE_URL = 'https://peanutsjamjam.jp/~sugawara/zigsaw/';

1;
